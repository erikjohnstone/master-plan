node_modules/
dist/
.DS_Store
.env
.env.*
worktrees/
opentakeoff-corpus/renders/

# Demo run dumps / localhost proofs stay out of git (keep locally; do not commit payloads)
opentakeoff-corpus/demos/**/runs/
opentakeoff-corpus/demos/**/local-host-run.json
opentakeoff-corpus/raw/
# NOT opentakeoff-corpus/keys/ — ground truth must survive a checkout.
# Removed 2026-09-04: a new key file was invisible to `git status` here,
# the exact trap the corpus's own read-only-keys rule assumes can't happen.
opentakeoff-corpus/takeoffs/**/runs/
opentakeoff-corpus/bulk/
opentakeoff/mcp/scripts/_tmp_*/

# GEMINI-VECTOR-SYMBOL-GROUNDING-GOAL.md Phase 0 — raw per-case baseline JSON
# (large, one array entry per case per mode/path/surface run). Commit only
# the compact dated summaries under opentakeoff-corpus/reports/ itself.
opentakeoff-corpus/reports/runs/

# The 30-document HVAC/BAS benchmark's source PDFs live on their own branch
# as Git LFS objects (codex/symbol-sweep-corpus-accuracy). They are
# materialised here (symlinked from an auxiliary worktree) to run against,
# never committed onto this branch: 526 MB, and committing them as plain
# blobs would put every byte in this history permanently. To get them:
#   git lfs fetch origin refs/remotes/origin/codex/symbol-sweep-corpus-accuracy
#   git worktree add --detach <path> origin/codex/symbol-sweep-corpus-accuracy
#   git lfs pull  # inside that worktree
#   ln -s "<path>/HVAC BAS Benchmark Collection/pdf" "HVAC BAS Benchmark Collection/pdf"
# ground_truth/symbol_sweep and ground_truth/legend_learn are NOT ignored —
# GEMINI-VECTOR-SYMBOL-GROUNDING-GOAL.md Phase 1 extends this ground truth
# directly on this execution branch (small JSON/markdown, not LFS content;
# the other ground_truth/ subtrees — work/, records/, verification/, tools/
# — are unrelated table/schedule ground truth this goal must not touch, and
# stay absent from this worktree rather than copied and ignored).
HVAC BAS Benchmark Collection/pdf
