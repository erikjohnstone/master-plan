{
  "name": "opentakeoff",
  "private": true,
  "workspaces": [
    "web",
    "mcp"
  ],
  "scripts": {
    "typecheck": "turbo run typecheck",
    "test:shared-path": "turbo run test:shared-path",
    "test:workflows": "turbo run test:workflows",
    "eval": "node scripts/eval.mjs",
    "emit:corpus": "OPENTAKEOFF_TABLE_SIDECAR=0 node --import tsx mcp/scripts/emit-corpus-takeoff.mjs --corpus ../opentakeoff-corpus --out out --resume",
    "emit:corpus:shard0": "OPENTAKEOFF_TABLE_SIDECAR=0 node --import tsx mcp/scripts/emit-corpus-takeoff.mjs --corpus ../opentakeoff-corpus --out out --resume --shard 0/4",
    "emit:corpus:shard1": "OPENTAKEOFF_TABLE_SIDECAR=0 node --import tsx mcp/scripts/emit-corpus-takeoff.mjs --corpus ../opentakeoff-corpus --out out --resume --shard 1/4",
    "emit:corpus:shard2": "OPENTAKEOFF_TABLE_SIDECAR=0 node --import tsx mcp/scripts/emit-corpus-takeoff.mjs --corpus ../opentakeoff-corpus --out out --resume --shard 2/4",
    "emit:corpus:shard3": "OPENTAKEOFF_TABLE_SIDECAR=0 node --import tsx mcp/scripts/emit-corpus-takeoff.mjs --corpus ../opentakeoff-corpus --out out --resume --shard 3/4",
    "prewarm:corpus": "OPENTAKEOFF_TABLE_SIDECAR=0 node --import tsx mcp/scripts/prewarm-corpus-graph.mjs --corpus ../opentakeoff-corpus",
    "prewarm:corpus:shard0": "OPENTAKEOFF_TABLE_SIDECAR=0 node --import tsx mcp/scripts/prewarm-corpus-graph.mjs --corpus ../opentakeoff-corpus --shard 0/4",
    "prewarm:corpus:shard1": "OPENTAKEOFF_TABLE_SIDECAR=0 node --import tsx mcp/scripts/prewarm-corpus-graph.mjs --corpus ../opentakeoff-corpus --shard 1/4",
    "prewarm:corpus:shard2": "OPENTAKEOFF_TABLE_SIDECAR=0 node --import tsx mcp/scripts/prewarm-corpus-graph.mjs --corpus ../opentakeoff-corpus --shard 2/4",
    "prewarm:corpus:shard3": "OPENTAKEOFF_TABLE_SIDECAR=0 node --import tsx mcp/scripts/prewarm-corpus-graph.mjs --corpus ../opentakeoff-corpus --shard 3/4",
    "eval:corpus": "node eval/runCorpusEval.mjs ../opentakeoff-corpus --out out"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  }
}
