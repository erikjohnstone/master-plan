{
  "name": "opentakeoff",
  "private": true,
  "workspaces": [
    "web",
    "mcp"
  ],
  "scripts": {
    "typecheck": "turbo run typecheck",
    "test:shared-path": "turbo run test:shared-path",
    "test:workflows": "turbo run test:workflows",
    "eval": "node scripts/eval.mjs",
    "emit:corpus": "node --import tsx mcp/scripts/emit-corpus-takeoff.mjs --corpus ../opentakeoff-corpus --out out --resume",
    "emit:corpus:shard0": "node --import tsx mcp/scripts/emit-corpus-takeoff.mjs --corpus ../opentakeoff-corpus --out out --resume --shard 0/2",
    "emit:corpus:shard1": "node --import tsx mcp/scripts/emit-corpus-takeoff.mjs --corpus ../opentakeoff-corpus --out out --resume --shard 1/2",
    "eval:corpus": "node eval/runCorpusEval.mjs ../opentakeoff-corpus --out out"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  }
}
