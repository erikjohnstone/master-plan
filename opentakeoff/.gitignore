# Dependencies
node_modules/
**/node_modules/

# Build output
web/dist/
**/dist/
out/

# Python (optional AI sandbox)
__pycache__/
*.pyc
.venv/
venv/
server/.venv/
.venv-bas/
bas_engine/build/
bas_engine/*.egg-info/
bas_engine/.mypy_cache/
bas_engine/.pytest_cache/
tmp/bas-proof/
mcp/tmp/bas-proof/

# Temporary corpus/debug scripts (see docs/SYMBOL-SWEEP-CLEAN-CORPUS-GOAL.md
# §0: "Temporary diagnostics live in mcp/scripts/tmp-*.mjs... and are never
# committed") — ignored outright so they never trip the untracked-files check.
mcp/scripts/tmp-*.mjs

# Local env / secrets — never commit
.env
.env.*
!.env.example

# Netlify CLI local state (never commit; the root netlify.toml IS committed)
.netlify/
**/.netlify/

# Editor / OS
.DS_Store
.vscode/
.idea/
*.log

# Agent/browser session artifacts (Playwright MCP traces, verification screenshots)
.playwright-mcp/
/*.png
.claude/

# node_modules symlinks too — the dir patterns above match only real directories,
# which is how a worktree convenience symlink once got committed
**/node_modules

# MCP compiled dist (published to npm, never committed)
mcp/dist/

# MCPB bundle build output (release artifact, never committed)
mcp/dist-mcpb/

# Smithery-only MCPB build output (see scripts/build-smithery-mcpb.mjs), never committed
mcp/dist-smithery/

# Tesseract language data downloaded at runtime by tesseract.js (never commit)
**/eng.traineddata

# Gunzipped ONNX models — table_structure_rpc.py extracts these from the
# vendored .onnx.gz files in sidecar/models/ on first use; regenerated
# locally, never committed
sidecar/.model_cache/

# Voice model artifacts (~45 MB) — staged by web/scripts/fetch-voice-model.mjs
# into public/ for same-origin serving; never committed (RFC #59)
web/public/models/
