            "goal-wp31",
            "lib"
          ]
        }
      ],
      "yes": [
        {
          "id": "smoke_detector",
          "re": "\\bSMOKE\\s+DETECT(?:OR|ORS|ION)\\b|\\b(?:SA|RA)-?SMK\\b|\\bDUCT\\s+DETECTORS?\\b",
          "sources": [
            "lib",
            "ufgs-230993-smk"
          ]
        }
      ]
    },
    "isolation_valve": {
      "device": "a motorized (actuated) isolation valve on the unit, commanded by the BAS, with its status",
      "mention": [
        {
          "id": "isolation_valve",
          "re": "\\bISOLATION\\s+VALVES?\\b|\\bISO\\.?\\s+(?:VALVES?|VLV)\\b|\\bSHUT-?OFF\\s+VALVES?\\b",
