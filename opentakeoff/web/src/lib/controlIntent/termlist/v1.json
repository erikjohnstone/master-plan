          "id": "actuated",
          "re": "\\bISOLATION\\s+VALVES?\\b[^.;]{0,40}\\b(?:AO|DO|BO|DI|BI|CONTROL|COMMAND|STATUS|END\\s+SWITCH(?:ES)?|ACTUATORS?|OPEN|CLOSE|POSITION)\\b|\\b(?:MOTORI[SZ]ED|AUTOMATIC|ACTUATED|MODULAT\\w*|OPEN|CLOSE)\\b[^.;]{0,30}\\bISOLATION\\s+VALVES?\\b",
